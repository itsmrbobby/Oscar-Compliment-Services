{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oscar-compliment-services",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "observability": { "enabled": true },
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "osca-db",
      "database_id": "68e4b9d7-1129-454d-af70-4ab1233ae8cb"
    }
  ]
}
