# Browser caching rules for Cloudflare.
# Photos are re-checked on every visit (a quick "has it changed?" question, so unchanged photos cost almost nothing),
# which means a replaced or newly added picture always reaches visitors. The phone's photo helper (sw.js) keeps them instant.
/images/*
  Cache-Control: public, no-cache

# Product list: refreshed every few minutes
/data/*
  Cache-Control: public, max-age=300

# Site code is versioned (?v=...), so it can be kept for an hour
/style.css
  Cache-Control: public, max-age=3600
/main.js
  Cache-Control: public, max-age=3600
/catalog.js
  Cache-Control: public, max-age=3600
/assistant.js
  Cache-Control: public, max-age=3600
/cms.js
  Cache-Control: public, max-age=3600
/config.js
  Cache-Control: public, max-age=3600

# The admin pages must never be kept
/admin.html
  Cache-Control: no-store
/admin.js
  Cache-Control: no-store

# The photo-cache helper must always be re-checked so updates reach visitors
/sw.js
  Cache-Control: no-cache

# Videos: kept for a day on the visitor's phone
/videos/*
  Cache-Control: public, max-age=86400
